{
  "name": "studyspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "test": "vitest run",
    "test:e2e": "node scripts/quality/playwright.mjs test",
    "test:e2e:install": "node scripts/quality/playwright.mjs install chromium",
    "tauri": "tauri",
    "desktop:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/install-build-tools.ps1",
    "desktop:rust": "python scripts/desktop/portable-rust.py",
    "desktop:dev": "node scripts/desktop/windows-build.mjs dev",
    "desktop:build": "node scripts/desktop/windows-build.mjs build",
    "desktop:build:offline": "node scripts/desktop/windows-build.mjs offline",
    "desktop:build:signed": "node scripts/desktop/windows-build.mjs signed",
    "desktop:build:offline:signed": "node scripts/desktop/windows-build.mjs offline-signed",
    "desktop:diagnose": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/diagnose-windows.ps1",
    "desktop:verify:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/verify-windows-release.ps1",
    "desktop:scan:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/scan-windows-release.ps1",
    "desktop:tooling:test": "node --test scripts/desktop/signing-config.test.mjs",
    "desktop:check": "node scripts/desktop/windows-build.mjs check",
    "desktop:verify": "node scripts/desktop/windows-build.mjs config",
    "desktop:test": "node scripts/desktop/windows-build.mjs test",
    "desktop:test:ci": "node scripts/desktop/windows-build.mjs test-ci",
    "desktop:build:qa": "node scripts/desktop/windows-build.mjs qa",
    "desktop:visual": "node scripts/quality/playwright.mjs test desktop-visual.spec.ts",
    "desktop:preserve": "node scripts/quality/frontend-preservation.mjs",
    "local:build": "npm run build && node scripts/local/prepare.mjs",
    "local:prepare": "node scripts/local/prepare.mjs",
    "start": "node runtime/launcher.mjs",
    "stop": "node runtime/launcher.mjs --stop"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.56.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
