# Provedor inicial: gemini, openai, groq, xai, nvidia, anthropic, deepseek,
# mistral, openrouter, together, fireworks, cerebras, ollama, lmstudio, custom.
# A selecao salva no painel prevalece sobre este valor inicial.
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TOOLS=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TOOLS=true

# Groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TOOLS=true

# xAI / Grok
XAI_API_KEY=
XAI_MODEL=
XAI_TOOLS=true

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_TOOLS=true

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TOOLS=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_TOOLS=true

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_TOOLS=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TOOLS=true

# Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=
TOGETHER_TOOLS=true

# Fireworks AI
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
FIREWORKS_TOOLS=true

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_TOOLS=true

# Ollama (local)
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_TOOLS=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# LM Studio (local)
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=
LMSTUDIO_TOOLS=true
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# API compatível personalizada
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_TOOLS=true
CUSTOM_BASE_URL=

# Transcricao do microfone: auto, gemini, groq, openai ou none.
# auto usa o provedor selecionado se compativel e configurado;
# caso contrario escolhe a primeira chave configurada: Groq, OpenAI, Gemini.
# O painel informa o destino antes de gravar. Falhas nunca trocam de provedor.
TRANSCRIPTION_PROVIDER=auto
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GEMINI_TRANSCRIPTION_MODEL=

# Leitura local, sem API de voz.
LOCAL_VOICE_ENABLED=true
LOCAL_VOICE_ID=Microsoft Maria Desktop
LOCAL_VOICE_VOLUME=0.8
LOCAL_VOICE_RATE=0
